              {
                "length": 3,
                "offset": 0,
                "style": "Bold"
              }
            ],
            "key": "cdo4k",
            "text": "中间栏：对话交互、执行思维链（CoT）展开与交付结果预览；",
            "type": "unordered-list-item"
          },
          {
