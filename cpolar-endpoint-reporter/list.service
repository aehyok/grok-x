[Unit]
Description=cpolar endpoint reporter (in-memory, system service)
After=network-online.target
Wants=network-online.target
# 崩溃循环保护
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/list --watch
Restart=always
RestartSec=10
# 以 root 运行：可直接读 root-only 的 cpolar 日志，无需 sudo

[Install]
WantedBy=multi-user.target
