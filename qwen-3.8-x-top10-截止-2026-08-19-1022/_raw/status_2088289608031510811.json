            "text": "Unsloth: https://unsloth.ai/docs/models/qwen3.8",
            "type": "unordered-list-item"
          },
          {
            "data": {},
            "entityRanges": [],
            "inlineStyleRanges": [],
            "key": "9t6sk",
            "text": "Happy building.",
            "type": "unstyled"
          }
        ],
        "entityMap": [
          {
            "key": "4",
            "value": {
              "data": {
                "markdown": "```\nSGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1 python -m sglang.launch_server ... --json-model-override-args '{\"text_config\": {\"rope_parameters\": {\"mrope_interleaved\": true, \"mrope_section\": [11, 11, 10], \"rope_type\": \"yarn\", \"rope_theta\": 10000000, \"partial_rotary_factor\": 0.25, \"factor\": 4.0, \"original_max_position_embeddings\": 262144}}}' --context-length 1000000\n```"
              },
              "mutability": "Mutable",
              "type": "MARKDOWN"
            }
          },
          {
            "key": "5",
            "value": {
              "data": {
                "markdown": "```\nTOKENSPEED_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1 tokenspeed serve ... --hf-overrides '{\"text_config\": {\"rope_parameters\": {\"mrope_interleaved\": true, \"mrope_section\": [11, 11, 10], \"rope_type\": \"yarn\", \"rope_theta\": 10000000, \"partial_rotary_factor\": 0.25, \"factor\": 4.0, \"original_max_position_embeddings\": 262144}}}' --max-model-len 1000000  \n```"
              },
