                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "7iag3",
              "text": "3️⃣ 补充 Cli 能力",
              "type": "header-two"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "egl53",
              "text": "让 AI 帮助我们安装好我们所需的CLI 能力，直接输入",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "887ta",
              "text": "帮我安装好 obsidian-cli",
              "type": "blockquote"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 18,
                  "length": 2,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "elian",
              "text": "⚠️ 如果只是创建和搜索笔记的话，Workbuddy 同样能做到，CLI 的真正优势在操作移动笔记的保持我们的双链是完整的，不会产生短链的情况，让我们的笔记一直都处于有关系的状态。",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 19,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "775v9",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 20,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "3m0tf",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 21,
                  "length": 3,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "94ae4",
              "text": "4️⃣ 验证读取能力",
              "type": "header-two"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "22u3n",
              "text": "此时我们便拥有了一个从底层去操作 Obsidian vault的能力，我们开始验证读取能力，直接在输入框中输入：",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "fltd3",
              "text": "只读取 OrbitOS,搜索标题或正文中包含“WorkBuddy”的笔记，返回文件路径和每篇笔记的一句话摘要。不要修改任何文件。",
              "type": "blockquote"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 22,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "3om8n",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "q3uf",
              "text": "此时可以看到他读取的都是我所希望读取的知识库，除此之外我并没有在 Workbuddy 中设定工作目录，所以他都是自行寻找的",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 23,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "2gkps",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 24,
                  "length": 3,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "8vv9g",
              "text": "5️⃣ 验证写入能力",
              "type": "header-two"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "ben5q",
              "text": "验证完读取能力之后，我们开始验证数据写入的能力，我们在输入框中输入下面的提示词：",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "6sjmj",
              "text": "请在 OrbitOS 的 00_收件箱 中创建一篇 WorkBuddy-Obsidian-测试.md。  添加创建日期，并写入一句“WorkBuddy 已成功连接 OrbitOS”。创建后重新读取文件进行验证，不要修改其他文件。",
              "type": "blockquote"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "5ac7c",
              "text": "同样的，我们也设定好所需操作的知识库，也并不给定具体的路径",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 25,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "e02bg",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 26,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "fdj7s",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 27,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "fl43g",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 28,
                  "length": 3,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "6cl7a",
              "text": "6️⃣ Workbuddy 直接操作本地文件和使用 Obsidian skill 有什么区别？",
              "type": "header-two"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "fackd",
              "text": "前者是把知识库当做了 Workbuddy 的工作目录了，本质上对于 Workbuddy 而言只是一堆 md 文件，是以文件形式去理解知识库，并无法主动性的跨库操作。",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "7s7l3",
              "text": "\n而后者是从 Obsidian 的设计出发，从工作方式去理解，你并不需要把知识库设定为工作目录即可操作。当你安装完毕之后，它可以自动的去识别本机有多少知识库，哪些是打开状态，正在操作状态，也能在合适的时间使用底层 cli 去操作知识库。",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [
                {
                  "key": 29,
                  "length": 1,
                  "offset": 0
                }
              ],
              "inlineStyleRanges": [],
              "key": "8uk18",
              "text": " ",
              "type": "atomic"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "9m3d",
              "text": "总结",
              "type": "header-two"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "fh4a1",
              "text": "所以我们最后总结下，直接用 Workbuddy 操作的话只是把知识库当做普通文件夹，而使用 Obsidian skill 的话是按照 Obsidian 的方式去操作知识库。",
              "type": "unstyled"
            },
            {
              "data": {},
              "entityRanges": [],
              "inlineStyleRanges": [],
              "key": "11as3",
              "text": "",
              "type": "unstyled"
            }
          ],
